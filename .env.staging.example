# ─────────────────────────────────────────────────────────────────────────────
# CONROY frontend — STAGING environment
#
# `main` commits a `.env.local` pointing at the production API. This branch does
# not: every value comes from the staging host's dashboard instead — Vercel →
# the staging project → Settings → Environment Variables — so a variable nobody
# set fails closed rather than quietly inheriting production's.
#
# Copy to `.env.local` for a local staging run. `.env.local` is gitignored here.
# ─────────────────────────────────────────────────────────────────────────────

# ── What makes this deployment staging ───────────────────────────────────────
# Shows the "Staging — test site" banner and blocks search engines from
# indexing this copy of the storefront. Absent = production behaviour.
NEXT_PUBLIC_APP_ENV=staging

# ── Where the storefront points ──────────────────────────────────────────────
# This deployment's own URL — canonical links and Open Graph.
NEXT_PUBLIC_SITE_URL=https://conroy-staging.vercel.app

# The STAGING backend, including the /api suffix. Must not be the production
# API: that would read the live catalogue and write live orders. Leave it unset
# and the storefront silently falls back to bundled demo data — a working page
# with no real checkout, which is the safe failure but not a valid test.
NEXT_PUBLIC_API_BASE_URL=https://conroy-backend-staging.vercel.app/api

# ── Staging Supabase project (NOT production) ────────────────────────────────
# From the STAGING project → Project Settings → API. Public values, safe in the
# browser bundle — the anon key respects Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Payments — TEST MODE ONLY ────────────────────────────────────────────────
# The rzp_test_… key id. Public by design; the secret stays on the backend.
# An rzp_live_ key here would open live checkout against test data.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
